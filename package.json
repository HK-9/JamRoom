{
  "name": "jamroom",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime group listening rooms with SoundCloud search, queue, and chat",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:web": "cd web && node node_modules/vite/bin/vite.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build:web": "cd web && node node_modules/vite/bin/vite.js build",
    "check": "node --check server/index.js",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}